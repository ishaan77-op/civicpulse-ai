# Environment. "development" is REQUIRED for local work: only then may the
# secrets below be left blank (insecure built-in dev defaults are used).
# Any other value, or leaving this unset, is treated as production and the
# app refuses to start unless SECRET_KEY and JWT_SECRET_KEY are real values.
APP_ENV=development

# Flask session / JWT signing secrets. Blank is only allowed when
# APP_ENV=development. Generate real ones with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# SQLAlchemy database URL. Defaults to a local SQLite file
# (backend/instance/civicpulse.db) if unset.
DATABASE_URL=

# Folder where complaint photos are stored and served from. Defaults to
# backend/uploads if unset. The test suite points this at a temp directory.
UPLOAD_FOLDER=

# Address and port the Flask dev server binds to (python app.py).
# HOST defaults to 127.0.0.1 (this machine only). Set HOST=0.0.0.0 ONLY if
# another device must reach the API directly; see README "Phone / LAN testing".
HOST=127.0.0.1
PORT=5001

# Set to 1 for Flask debug mode / auto-reload. Off by default. Honoured only
# when APP_ENV=development AND HOST is a loopback address - it is ignored
# (with a warning) otherwise, so the debugger is never exposed to the network.
FLASK_DEBUG=0

# Largest accepted complaint photo in MB (default 10).
MAX_UPLOAD_MB=10

# Google Gemini API key used by services/ai_service.py for complaint
# analysis (category, priority, department, summary). Required for the
# AI analysis step to work.
GEMINI_API_KEY=

# Gemini model name. Defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=gemini-3.6-flash
