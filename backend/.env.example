# Copy this file to .env and fill in real values. Never commit .env.

# Flask session/signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT signing secret (Flask-JWT-Extended). Generate the same way as SECRET_KEY.
# Must be at least 32 bytes to avoid the InsecureKeyLengthWarning.
JWT_SECRET_KEY=

# Google Gemini API key, used by services/ai_service.py to analyze each
# complaint's text + photo (category, priority, department, summary).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: overrides the default database (SQLite at instance/civicpulse.db).
# DATABASE_URL=postgresql://user:password@localhost:5432/civicpulse

# Optional: Flask dev server port (default 5001).
# PORT=5001

# Optional: enables Flask debug mode (default off). Never enable in production.
# FLASK_DEBUG=false

# Optional: Gemini model override (default gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash
